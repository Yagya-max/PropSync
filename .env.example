# PropSync Environment Variables Configuration

# Meta WhatsApp Cloud API Credentials
META_VERIFY_TOKEN=your_verify_token_here
META_ACCESS_TOKEN=your_whatsapp_access_token_here
META_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here

# Supabase Credentials (DB & Storage)
# Local Postgres fallback if needed: postgresql://postgres:password@localhost:5432/propsync?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/propsync?schema=public
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE=your-service-role-key

# Upstash Redis Credentials (REST interface API)
UPSTASH_REDIS_REST_URL=https://your-redis-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token-here

# Google AI Studio Gemini API Key
GEMINI_API_KEY=your-google-gemini-api-key-here

# General App Config
PORT=5001
NEXT_PUBLIC_APP_URL=http://localhost:4009
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001
